{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node16",
    "types": ["node"],
    "allowJs": false,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc-prod.tsbuildinfo"
  },
  "include": [
    "modules/**/*.ts",
    "market_adapter/**/*.ts",

    "scripts/**/*.ts",
    "analysis/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "profiles",
    "tests"
  ]
}
